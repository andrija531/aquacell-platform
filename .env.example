# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Generate secrets with:  openssl rand -hex 32

# ---- EMQX ----
# Erlang distribution cookie. Any long random string.
EMQX_NODE_COOKIE=changeme-long-random-string
# Dashboard login for user "admin" on http://127.0.0.1:18083
EMQX_DASHBOARD_PASSWORD=changeme

# ---- Postgres / TimescaleDB ----
POSTGRES_DB=aquacell
POSTGRES_USER=aquacell
POSTGRES_PASSWORD=changeme
# Consumed by the Erlang core and the Python scheduler.
DATABASE_URL=postgresql://aquacell:changeme@127.0.0.1:5432/aquacell

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
# Consumer group for the Erlang schedule consumer (decision #37).
REDIS_SCHEDULE_STREAM=aquacell:schedules
REDIS_SCHEDULE_GROUP=core_engine

# ---- MQTT, as seen by the Erlang core ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Where each listener is published.
#
# Local development: leave both on loopback.
# LAN test with a real device: MQTT_TCP_BIND=0.0.0.0 (plaintext, trusted
#   network only — the device password crosses the wire in clear).
# Internet-facing server: leave MQTT_TCP_BIND on 127.0.0.1 and set
#   MQTT_TLS_BIND=0.0.0.0. The Erlang core talks to the broker over the
#   compose network as "emqx", so 1883 never needs to leave the host.
MQTT_TCP_BIND=127.0.0.1
MQTT_TLS_BIND=127.0.0.1

# Certificate for the 8883 listener, as paths INSIDE the container.
# ./infrastructure/emqx/certs is mounted at /opt/emqx/etc/certs/aquacell.
# Unset means the image's self-signed pair, which no device will validate.
#
# With a hostname + Let's Encrypt (preferred — devices use their built-in CA
# bundle and need no per-device setup):
#   MQTT_TLS_CERTFILE=/opt/emqx/etc/certs/aquacell/fullchain.pem
#   MQTT_TLS_KEYFILE=/opt/emqx/etc/certs/aquacell/privkey.pem
# With scripts/make_server_cert.sh (self-signed; each device needs the CA
# uploaded via scripts/shelly_put_ca.sh):
#   MQTT_TLS_CERTFILE=/opt/emqx/etc/certs/aquacell/server.crt
#   MQTT_TLS_KEYFILE=/opt/emqx/etc/certs/aquacell/server.key
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=

# Number of shared-subscription workers (decision #30). One wildcard
# subscriber is a bottleneck and a single point of failure.
MQTT_INGEST_SHARDS=8
MQTT_SHARED_GROUP=ingest
MQTT_CORE_USERNAME=core_engine
MQTT_CORE_PASSWORD=changeme

# ---- Safety limits ----
# Hard ceiling on aggregate state change per minute, enforced in Erlang on the
# last hop (decision #54). This is the control that survives a compromised
# optimiser, so it is configured here and not in the Python layer.
RAMP_GOVERNOR_MAX_KW_PER_MIN=500
# Twin state older than this is "unknown": release the device to its
# mechanical thermostat rather than acting on a stale estimate (decision #32).
TWIN_STALE_AFTER_S=900
