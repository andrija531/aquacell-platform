# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Generate secrets with:  openssl rand -hex 32

# ---- EMQX ----
# Erlang distribution cookie. Any long random string.
EMQX_NODE_COOKIE=changeme-long-random-string
# Dashboard login for user "admin" on http://127.0.0.1:18083
EMQX_DASHBOARD_PASSWORD=changeme

# ---- Postgres / TimescaleDB ----
POSTGRES_DB=aquacell
POSTGRES_USER=aquacell
POSTGRES_PASSWORD=changeme
# Consumed by the Erlang core and the Python scheduler.
DATABASE_URL=postgresql://aquacell:changeme@127.0.0.1:5432/aquacell

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
# Consumer group for the Erlang schedule consumer (decision #37).
REDIS_SCHEDULE_STREAM=aquacell:schedules
REDIS_SCHEDULE_GROUP=core_engine

# ---- MQTT, as seen by the Erlang core ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Number of shared-subscription workers (decision #30). One wildcard
# subscriber is a bottleneck and a single point of failure.
MQTT_INGEST_SHARDS=8
MQTT_SHARED_GROUP=ingest
MQTT_CORE_USERNAME=core_engine
MQTT_CORE_PASSWORD=changeme

# ---- Safety limits ----
# Hard ceiling on aggregate state change per minute, enforced in Erlang on the
# last hop (decision #54). This is the control that survives a compromised
# optimiser, so it is configured here and not in the Python layer.
RAMP_GOVERNOR_MAX_KW_PER_MIN=500
# Twin state older than this is "unknown": release the device to its
# mechanical thermostat rather than acting on a stale estimate (decision #32).
TWIN_STALE_AFTER_S=900
