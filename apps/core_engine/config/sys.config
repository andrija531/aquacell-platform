%% -*- erlang -*-
%% Runtime configuration. Values are read from the environment so the same
%% release runs in dev and production; see .env.example at the repo root for
%% the full list and what each one is for.
[
 {aquacell,
  [
   %% Decision #30. One wildcard subscriber is a bottleneck and a SPOF.
   {mqtt_ingest_shards, 8},
   {mqtt_shared_group, "ingest"},

   %% Decision #54. Hard ceiling enforced on the last hop, in Erlang.
   {ramp_governor_max_kw_per_min, 500},

   %% Decision #32. Older than this, the twin's state is unknown and the
   %% device is released to its mechanical thermostat.
   {twin_stale_after_s, 900}
  ]},

 {kernel,
  [
   {logger_level, info},
   {logger,
    [{handler, default, logger_std_h,
      #{formatter => {logger_formatter, #{single_line => true}}}}]}
  ]}
].
