%%--------------------------------------------------------------------
%% AquaCell real-time core.
%%
%% This is a skeleton: an application and a supervisor that boot an empty
%% tree. It exists so the toolchain is proven before any logic lands, which
%% is the awkward part of starting an Erlang project. See src/aquacell_sup.erl
%% for the intended children and the order they must start in.
%%
%% Decision #75: build the Erlang core early. It is the hardest layer to
%% retrofit, so it must not be deferred even though Phase 0 is one flat.
%%--------------------------------------------------------------------

%% OTP 27 for the built-in `json` module. Telemetry arrives as JSON and this
%% avoids a dependency on jsx or jiffy.
{minimum_otp_vsn, "27.0"}.

{erl_opts, [
    debug_info,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_missing_spec,
    warnings_as_errors
]}.

{deps, [
    %% MQTT client. Connects to EMQX using shared subscriptions
    %% ($share/ingest/...) so the broker load-balances ingest across N
    %% workers. Decision #30: a single wildcard subscriber funnels every
    %% message through one mailbox and will queue and OOM on a reconnect
    %% storm.
    %%
    %% Pinned to a git tag rather than the Hex package, deliberately.
    %% The Hex package emqtt 1.16.0 declares quicer as a NON-optional
    %% dependency, and rebar3 resolves Hex deps from published package
    %% metadata without evaluating the package's own rebar.config.script.
    %% That makes the BUILD_WITHOUT_QUIC escape hatch unreachable via Hex, so
    %% quicer is always fetched and its NIF build fails on any machine without
    %% make, cmake and a C compiler.
    %%
    %% As a git dep the script does run, and rebar.config.script in this
    %% directory sets BUILD_WITHOUT_QUIC so quicer is dropped. AquaCell has no
    %% use for MQTT over QUIC: the devices are Shelly relays on TCP/TLS and
    %% EMQX's QUIC listener is disabled.
    {emqtt, {git, "https://github.com/emqx/emqtt.git", {tag, "1.16.0"}}},

    %% Postgres client with built-in pooling.
    %% Decision #34: pgo ONLY. The original rebar.config listed both pgo and
    %% epgsql; running two drivers against one database is a maintenance tax
    %% with no upside.
    {pgo, "0.20.0"},

    %% Process registry for the device twins.
    %% Decision #31: register via {via, gproc, {n, l, {boiler, Mac}}}, NEVER
    %% list_to_atom(Mac). Dynamic atoms are never garbage collected and the
    %% default limit is around 1M, so a MAC-keyed atom table is a slow leak
    %% toward a hard node crash.
    {gproc, "1.3.0"}
]}.

{shell, [
    {apps, [aquacell]}
]}.

{relx, [
    {release, {aquacell, "0.1.0"}, [aquacell, sasl]},
    {mode, prod},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {dev, [
        {relx, [
            {mode, dev},
            {debug_info, keep}
        ]}
    ]},
    {test, [
        {erl_opts, [nowarn_missing_spec, nowarn_export_all]}
    ]}
]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling]}
]}.

{xref_checks, [
    undefined_function_calls,
    locals_not_used,
    deprecated_function_calls
]}.
