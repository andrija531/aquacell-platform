# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Erlang / rebar3 ----
_build/
.rebar3/
*.beam
erl_crash.dump
# rebar.lock is intentionally NOT ignored. core_engine is an application, not
# a library, so the lock file belongs in the repo for reproducible builds.

# ---- Node / Next.js ----
node_modules/
.next/
out/
*.tsbuildinfo

# ---- Secrets and local config ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.srl
# Broker certificates are per-host and the keys are private. Keep the
# directory's own README so the layout is still documented.
infrastructure/emqx/certs/*
!infrastructure/emqx/certs/README.md

# ---- Generated simulator output ----
# Everything in data/ is reproducible from run_year.py; see apps/simulator/README
# for the commands. Tracking the 17 MB year_15min.csv.gz would bloat the history
# for no benefit.
apps/simulator/data/

# ---- Runtime volumes and logs ----
*.log
/volumes/
/data/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
